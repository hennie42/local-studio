[Unit]
Description=llama-swap local LLM router (127.0.0.1:8080)
After=network.target

[Service]
# config generated by models/gen-config.py (install.sh); -watch-config reloads it on change
ExecStart=%h/.local/bin/llama-swap -config %h/.config/llama-swap/config.yaml -listen 127.0.0.1:8080 -watch-config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
