#!/usr/bin/env bash
# Encode a Movie Render Queue image sequence (PNG/JPG/EXR) to video with ffmpeg.
# Usage: render-to-mp4 <frames-dir> [fps=30] [out.mp4]   (env PRORES=1 -> .mov ProRes 422 HQ for editing)
set -euo pipefail
dir=${1:?usage: render-to-mp4 <frames-dir> [fps] [out]}; fps=${2:-30}
# Glob, not `find | head`: with pipefail, head closing the pipe kills the script (SIGPIPE, exit 141)
shopt -s nullglob nocaseglob
frames=("$dir"/*.png "$dir"/*.jpg "$dir"/*.exr)
shopt -u nocaseglob
(( ${#frames[@]} )) || { echo "no PNG/JPG/EXR frames in $dir" >&2; exit 1; }
first=${frames[0]}
ext=${first##*.}
if [[ ${PRORES:-0} == 1 ]]; then
  out=${3:-${dir%/}.mov}
  enc=(-c:v prores_ks -profile:v 3 -pix_fmt yuv422p10le)
else
  out=${3:-${dir%/}.mp4}
  enc=(-c:v hevc_nvenc -preset p7 -tune hq -rc vbr -cq 18 -b:v 0 -pix_fmt p010le -tag:v hvc1)
fi
[[ -e $out ]] && { echo "$out already exists; not overwriting" >&2; exit 1; }
# EXR frames from Movie Render Queue are scene-linear; convert to BT.709 for viewing
vf=(); [[ ${ext,,} == exr ]] && vf=(-vf "zscale=tin=linear:pin=709:t=709:p=709:m=709:r=tv")
# -n: never overwrite an existing output file
ffmpeg -n -hide_banner -loglevel warning -stats -framerate "$fps" -pattern_type glob -i "$dir/*.$ext" \
  "${vf[@]}" "${enc[@]}" -movflags +faststart "$out"
echo "wrote $out"
