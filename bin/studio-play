#!/usr/bin/env python3
"""studio-play: start a project's exported Linux game for a human playtest, on the GPU the monitor is on.

  studio-play <project> [game args...]      e.g. studio-play /home/user/StudioProjects/godot/DontPanicIsland --skip-intro

The game runs in the foreground; its log is in ~/.local/share/godot/app_userdata/<name>/logs/.

GPU: the display GPU (the card the monitor is connected to) when it has >= 2 GB of video memory free. Rendering on
the other card costs a copy of every frame across PCIe, which grows with the window: DontPanicIsland ran at ~25 fps
with a ~0.1 s stall after the first dig in a 1920x2100 window on the RTX 2060, and at a locked 60 fps with no stall
on the RTX 5070 Ti that drives the monitor (F43). Only when the display GPU is full (a worker model is
loaded) does it fall back to the Godot jobs' GPU, after unloading the small local models parked there
(STUDIO_SMALL_MODELS, e.g. Spark on the RTX 2060: loaded, they leave the game no video memory and it shows a black
screen); llama-swap loads them again on the next request that needs them.
"""
import subprocess
import json
import os
import pathlib
import sys
import time
import urllib.request

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "lib"))
from studio_config import cfg, items  # noqa: E402

LLAMA_URL = cfg["STUDIO_LLAMA_URL"]


def running():
    try:
        return [m.get("model") for m in json.load(urllib.request.urlopen(LLAMA_URL + "/running", timeout=5))
                .get("running", [])]
    except Exception:
        return []


def display_gpu():
    """(nvidia-smi index, free MiB) of the GPU a connected monitor is on, or None."""
    drm = pathlib.Path("/sys/class/drm")
    for conn in sorted(drm.glob("card*-*")):
        try:
            if (conn / "status").read_text().strip() != "connected":
                continue
            bus = (drm / conn.name.split("-")[0] / "device").resolve().name.lower()     # e.g. 0000:65:00.0
        except OSError:
            continue
        out = subprocess.run(["nvidia-smi", "--query-gpu=index,pci.bus_id,memory.free", "--format=csv,noheader,nounits"],
                             capture_output=True, text=True).stdout
        for line in out.splitlines():
            idx, pci, free = [x.strip() for x in line.split(",")]
            if pci.lower().endswith(bus[-12:]):       # nvidia-smi pads the domain: 00000000:65:00.0
                return int(idx), int(free)
    return None


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        sys.exit(__doc__)
    project = pathlib.Path(sys.argv[1]).resolve()
    games = sorted((project / "build/linux").glob("*.x86_64"))
    if not games:
        sys.exit(f"no Linux export in {project}/build/linux (run there: studio godot-export linux)")
    argv = [str(games[0])]
    disp = display_gpu()
    if disp and disp[1] >= 2048:
        print(f"studio-play: on the display GPU (index {disp[0]}, {disp[1]} MiB free)", flush=True)
        argv += ["--gpu-index", str(disp[0])]      # nvidia-smi and Vulkan enumerate by PCI bus here (checked)
        if os.environ.get("WAYLAND_DISPLAY"):      # X11 via XWayland can't present from this GPU ("!present_queue_family")
            argv += ["--display-driver", "wayland"]
        if len(sys.argv) > 2:
            argv += ["--", *sys.argv[2:]]
        os.execv(argv[0], argv)
    print("studio-play: the display GPU is full (a worker model?): falling back to the Godot jobs' GPU; expect a low"
          " frame rate from the copy to the display GPU", flush=True)
    small = items("STUDIO_SMALL_MODELS")
    loaded = [m for m in running() if m in small]
    for m in loaded:
        req = urllib.request.Request(f"{LLAMA_URL}/api/models/unload/{m}", method="POST")
        try:
            urllib.request.urlopen(req, timeout=60)
            print(f"studio-play: unloaded {m} to free its GPU for the game", flush=True)
        except Exception as e:
            print(f"studio-play: could not unload {m}: {e}", flush=True)
    for _ in range(60):   # wait until the VRAM is really free
        if not any(m in small for m in running()):
            break
        time.sleep(0.5)
    if cfg.get("STUDIO_GODOT_ON_SMALL_GPU") == "1":
        argv += ["--gpu-index", cfg["STUDIO_GODOT_GPU"]]
    if len(sys.argv) > 2:
        argv += ["--", *sys.argv[2:]]   # game flags are user args (OS.get_cmdline_user_args)
    os.execv(argv[0], argv)


if __name__ == "__main__":
    main()
