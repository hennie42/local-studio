#!/usr/bin/env python3
"""studio-retro: the end-of-project retrospective (docs/self-improvement-design.md).

  studio-retro <project> [--name NAME] [--out FILE]

Reads retros/<NAME>/findings.jsonl (NAME defaults to the project folder's name) and the project's dispatcher state
(.studio/dispatch.json), and writes retros/<NAME>/retro.md: findings per cause with their cost, who caught them
(the escape rate: found by the user, no check caught it), first-try rate and minutes per model and attempt kind,
and the open guards to turn into lint rules, helpers, template files, checklist items or worker pitfalls. A
hand-written "## Lessons" section at the end of an existing retro.md is kept.
"""
import argparse
import collections
import json
import pathlib
import sys

REPO = pathlib.Path(__file__).resolve().parents[1]


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("project")
    ap.add_argument("--name")
    ap.add_argument("--out")
    a = ap.parse_args()
    proj = pathlib.Path(a.project).resolve()
    name = a.name or proj.name
    fpath = REPO / "retros" / name / "findings.jsonl"
    if not fpath.exists():
        sys.exit(f"no findings at {fpath}")
    F = [json.loads(l) for l in fpath.read_text().splitlines() if l.strip()]
    state = proj / ".studio/dispatch.json"
    D = json.loads(state.read_text()) if state.exists() else {}
    L = [f"# Retro: {name}", "", f"{len(F)} findings, {sum(f.get('cost_min', 0) for f in F)} minutes lost "
         f"in total. Format and loop: docs/self-improvement-design.md.", ""]

    # who caught what: the escape rate
    caught = collections.Counter(f["caught_by"] for f in F)
    esc = caught.get("user", 0)
    L += ["## Who caught the problems", "", "| caught by | findings | share |", "|---|---|---|"]
    for k, v in caught.most_common():
        L.append(f"| {k} | {v} | {v / len(F):.0%} |")
    L += ["", f"**Escape rate: {esc / len(F):.0%}** ({esc} of {len(F)} found by the user, no check caught them). "
          "Lower is better; compare with the next project.", ""]

    # per cause: count and cost
    by = collections.defaultdict(list)
    for f in F:
        by[f["cause"]].append(f)
    L += ["## Causes", "", "| cause | findings | minutes | by the user | examples |", "|---|---|---|---|---|"]
    for c, fs in sorted(by.items(), key=lambda kv: -sum(x.get("cost_min", 0) for x in kv[1])):
        ex = "; ".join(x["what"] for x in fs[:2])
        L.append(f"| {c} | {len(fs)} | {sum(x.get('cost_min', 0) for x in fs)} | "
                 f"{sum(x['caught_by'] == 'user' for x in fs)} | {ex} |")
    L.append("")

    # models and attempt kinds, from the dispatcher
    if D:
        stats = collections.defaultdict(lambda: [0, 0, 0])   # attempts, passes, seconds
        for tid, s in D.items():
            for at in s.get("attempts", []):
                k = (at.get("model"), at.get("kind"))
                stats[k][0] += 1
                stats[k][1] += str(at.get("check", "")).startswith("pass")
                stats[k][2] += at.get("seconds", 0)
        L += ["## Workers (dispatcher attempts)", "", "| model | attempt | attempts | passed | rate | minutes |",
              "|---|---|---|---|---|---|"]
        for (m, k), (n, p, sec) in sorted(stats.items(), key=lambda kv: (kv[0][1] != "first", kv[0])):
            L.append(f"| {m} | {k} | {n} | {p} | {p / n:.0%} | {sec / 60:.0f} |")
        done = [t for t, s in D.items() if s.get("status") == "pass"]
        esc_t = [t for t, s in D.items() if s.get("status") == "escalated"]
        L += ["", f"{len(done)} tickets passed, {len(esc_t)} escalated"
              + (f" ({', '.join(esc_t)})" if esc_t else "") + ".", ""]

    # guards
    L += ["## Guards", ""]
    for status, title in (("todo", "Open: turn these into guards"), ("done", "In place"), ("none", "One-offs")):
        fs = [f for f in F if f.get("guard", {}).get("status") == status]
        if not fs:
            continue
        L += [f"### {title} ({len(fs)})", ""]
        by_kind = collections.defaultdict(list)
        for f in fs:
            by_kind[f["guard"]["kind"]].append(f)
        for kind, items in sorted(by_kind.items()):
            refs = collections.OrderedDict()
            for f in items:
                refs.setdefault(f["guard"]["ref"], []).append(f["id"])
            for ref, ids in refs.items():
                L.append(f"- **{kind}**: {ref} ({', '.join(ids)})")
        L.append("")
    out = pathlib.Path(a.out) if a.out else REPO / "retros" / name / "retro.md"
    old = out.read_text() if out.exists() else ""
    if "\n## Lessons" in old:                      # the director's lessons survive a rerun
        L.append(old[old.index("\n## Lessons") + 1:].rstrip("\n"))
    out.write_text("\n".join(L) + "\n")
    print(f"wrote {out}")
    print(f"escape rate {esc / len(F):.0%}; open guards: "
          f"{sum(f.get('guard', {}).get('status') == 'todo' for f in F)}")


if __name__ == "__main__":
    main()
