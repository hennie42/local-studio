#!/usr/bin/env python3
"""studio-status: the progress dashboard (docs/dashboard.md). Watches every long job in the studio; the only
control is Pause / Resume.

  studio-status                serve the page on the LAN (port 8767; the systemd unit studio-status runs this)
  studio-status --once         the summary as text (terminals, the director's monitors)
  studio-status --line         one line for the Claude Code status line (--cached: the service's, if fresh)
  studio-status --json         the /api/status JSON (the page's contract)
  studio-status url            the link with the token (open it once per browser: it sets a cookie)

Plain HTTP on all interfaces, guarded by a random token in ~/.config/studio/dashboard-token (requests without the
cookie get 403). The firewall should allow the port from the home subnet only (ufw; the user adds the rule).
Alerts (escalations, finished runs, failed jobs, stalls) go to notify-send and the page's title.
"""
import argparse
import http.cookies
import http.server
import json
import pathlib
import secrets
import socket
import subprocess
import sys
import threading
import time
import urllib.parse

LIB = pathlib.Path(__file__).resolve().parents[1] / "lib"
sys.path.insert(0, str(LIB))
import studio_status as ss  # noqa: E402

PORT = 8767                   # 8766 is studio-serve's default (web-game tests)
TOKEN_FILE = pathlib.Path.home() / ".config/studio/dashboard-token"
PAGE = LIB / "status_page.html"
POLL_S = 5
COOKIE = "studio_token"
LINE_CACHE = pathlib.Path.home() / ".cache/studio-status/line.txt"   # the service's status line, for --cached


def token():
    if not TOKEN_FILE.exists():
        TOKEN_FILE.parent.mkdir(parents=True, exist_ok=True)
        TOKEN_FILE.write_text(secrets.token_urlsafe(24) + "\n")
        TOKEN_FILE.chmod(0o600)
    return TOKEN_FILE.read_text().strip()


def lan_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("10.255.255.255", 1))   # no packet is sent: picks the interface a LAN route would use
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


class State:
    """The newest collection, refreshed by one background thread so many viewers cost one scan."""

    def __init__(self):
        self.lock = threading.Lock()
        self.status, self.seen = None, None

    def refresh(self):
        s = ss.collect()
        with self.lock:
            self.status = s
        LINE_CACHE.parent.mkdir(parents=True, exist_ok=True)
        LINE_CACHE.write_text(ss.status_line(s) + "\n")
        self.notify(s)

    def get(self):
        with self.lock:
            if self.status is None:
                self.status = ss.collect()
            return self.status

    def notify(self, s):
        keys = {a["key"]: a for a in s["alerts"]}
        if self.seen is not None:
            for k, a in keys.items():
                if k not in self.seen:
                    subprocess.run(["notify-send", "-a", "studio", "-u", "critical" if a["level"] == "red" else
                                    "normal", f"studio: {a['title']}", a.get("detail", "")],
                                   stderr=subprocess.DEVNULL)
        self.seen = set(keys)


STATE = State()


def poller():
    while True:
        try:
            STATE.refresh()
        except Exception as e:   # a bad file must not kill the service: log and keep polling
            print(f"studio-status: collect failed: {e!r}", file=sys.stderr, flush=True)
        time.sleep(POLL_S)


def pause_target(target):
    """'evals' or a dispatcher project's name -> its PAUSE file (None if it has no pause mechanism)."""
    s = STATE.get()
    if target == "evals":
        return pathlib.Path(s["eval_pause"]["path"])
    for v in s["projects"]:
        if v["name"] == target and v["can_pause"]:
            return pathlib.Path(v["path"]) / ".studio/PAUSE"
    return None


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "studio-status"

    def log_message(self, fmt, *args):   # quiet: the page polls every 5 s
        pass

    def authed(self):
        c = http.cookies.SimpleCookie(self.headers.get("Cookie", ""))
        return COOKIE in c and secrets.compare_digest(c[COOKIE].value, token())

    def send(self, code, body, ctype="application/json", extra=None):
        data = body if isinstance(body, bytes) else body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        if u.path == "/" and q.get("t") and secrets.compare_digest(q["t"][0], token()):
            self.send(303, "", "text/plain", {"Location": "/", "Set-Cookie":
                      f"{COOKIE}={token()}; Path=/; Max-Age=31536000; HttpOnly; SameSite=Strict"})
            return
        if not self.authed():
            self.send(403, "forbidden: open the link from `studio-status url` once in this browser\n",
                      "text/plain")
            return
        if u.path == "/":
            self.send(200, PAGE.read_bytes(), "text/html; charset=utf-8",
                      {"Content-Security-Policy": "default-src 'self'; style-src 'unsafe-inline' 'self'; "
                                                  "script-src 'unsafe-inline' 'self'; img-src 'self' data:"})
        elif u.path == "/api/status":
            self.send(200, json.dumps(STATE.get()))
        elif u.path == "/api/image":
            name = q.get("project", [""])[0]
            v = next((v for v in STATE.get()["projects"] if v["name"] == name and v["image"]), None)
            if not v:
                self.send(404, "no image\n", "text/plain")
                return
            p = pathlib.Path(v["image"]["path"])
            ctype = {".png": "image/png", ".webp": "image/webp"}.get(p.suffix.lower(), "image/jpeg")
            try:
                self.send(200, p.read_bytes(), ctype, {"Cache-Control": "max-age=30"})
            except OSError:
                self.send(404, "gone\n", "text/plain")
        else:
            self.send(404, "not found\n", "text/plain")

    def do_POST(self):
        u = urllib.parse.urlparse(self.path)
        if not self.authed():
            self.send(403, '{"error": "forbidden"}')
            return
        if u.path not in ("/api/pause", "/api/resume"):
            self.send(404, '{"error": "not found"}')
            return
        try:
            body = json.loads(self.rfile.read(min(int(self.headers.get("Content-Length", 0)), 4096)) or b"{}")
        except ValueError:
            body = {}
        f = pause_target(str(body.get("target", "")))
        if f is None:
            self.send(400, '{"error": "this job has no pause mechanism"}')
            return
        if u.path == "/api/pause":
            f.write_text(f"paused from the dashboard {ss.now_iso()}\n")
        else:
            f.unlink(missing_ok=True)
        STATE.refresh()
        self.send(200, json.dumps({"ok": True, "paused": f.exists(), "file": str(f)}))


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", nargs="?", choices=["serve", "url"], default="serve")
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--line", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--cached", action="store_true", help="with --line: the service's line if under 30 s old")
    ap.add_argument("--port", type=int, default=PORT)
    a = ap.parse_args()
    if a.line and a.cached and time.time() - (LINE_CACHE.stat().st_mtime if LINE_CACHE.exists() else 0) < 30:
        print(LINE_CACHE.read_text().strip())
        return 0
    if a.once or a.line or a.json:
        s = ss.collect()
        print(json.dumps(s, indent=1) if a.json else ss.status_line(s) if a.line else ss.text_summary(s))
        return 0
    if a.cmd == "url":
        print(f"http://{lan_ip()}:{a.port}/?t={token()}")
        return 0
    token()
    threading.Thread(target=poller, daemon=True).start()
    srv = http.server.ThreadingHTTPServer(("0.0.0.0", a.port), Handler)
    print(f"studio-status on port {a.port} (studio-status url prints the link)", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    sys.exit(main())
