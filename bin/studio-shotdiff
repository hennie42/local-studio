#!/usr/bin/env python3
"""studio-shotdiff: compare two screenshots of the same view, before and after a visual change, in numbers.

  studio-shotdiff before.png after.png

Prints, for the whole picture and for its top, middle and bottom thirds: mean brightness, colour saturation,
contrast (the brightness spread) and detail (local edge strength: blur lowers it). Use it with every look change:
the first "visual polish" of Don't Panic Island hazed the picture (a tinted vignette overlay: contrast 53 -> 48) and
blurred the top rows, and only the numbers made the cause obvious. Prints "LOOK WORSE" when contrast or detail drop
by more than 5 % anywhere.
"""
import sys

import numpy as np
from PIL import Image


def stats(img):
    a = np.asarray(img.convert("RGB")).astype(float) / 255.0
    lum = a @ np.array([0.299, 0.587, 0.114])
    mx, mn = a.max(axis=2), a.min(axis=2)
    sat = np.where(mx > 0, (mx - mn) / np.maximum(mx, 1e-6), 0)
    gy, gx = np.abs(np.diff(lum, axis=0))[:, :-1], np.abs(np.diff(lum, axis=1))[:-1, :]
    return {"brightness": lum.mean(), "saturation": sat.mean(), "contrast": lum.std(), "detail": (gx + gy).mean()}


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    a, b = Image.open(sys.argv[1]), Image.open(sys.argv[2])
    if a.size != b.size:
        b = b.resize(a.size)
    h = a.size[1]
    regions = {"all": (0, h), "top": (0, h // 3), "middle": (h // 3, 2 * h // 3), "bottom": (2 * h // 3, h)}
    worse = False
    print(f"{'region':8s} {'measure':11s} {'before':>8s} {'after':>8s} {'change':>8s}")
    for name, (y0, y1) in regions.items():
        sa = stats(a.crop((0, y0, a.size[0], y1)))
        sb = stats(b.crop((0, y0, b.size[0], y1)))
        for k in sa:
            ch = (sb[k] - sa[k]) / max(sa[k], 1e-6)
            flag = ""
            if k in ("contrast", "detail") and ch < -0.05:
                flag, worse = "  <- lower", True
            print(f"{name:8s} {k:11s} {sa[k]:8.3f} {sb[k]:8.3f} {ch:+8.1%}{flag}")
    print("LOOK WORSE: contrast or detail dropped" if worse else "LOOK OK: no contrast or detail lost")
    sys.exit(1 if worse else 0)


if __name__ == "__main__":
    main()
